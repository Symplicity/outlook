parameters:
    level: 8
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        -
            identifier: missingType.generics
        -
            identifier: missingType.iterableValue
    paths:
        - src
    excludePaths:
        analyse:
            - src/Utilities/CalendarView/PageIterator.php
            - src/RequestConfigurationTrait.php
    fileExtensions:
        - php
